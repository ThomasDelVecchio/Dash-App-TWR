# Financial Modeling Prep API Key (Optional)
# Get free key at: https://site.financialmodelingprep.com/
FMP_API_KEY=demo

# Portfolio Targets
TARGET_PORTFOLIO_VALUE=50000.0
TARGET_MONTHLY_CONTRIBUTION=400

# Tax Rates (Decimal)
TAX_RATE_ST=0.35
TAX_RATE_LT=0.15

# Risk Parameters
RISK_FREE_RATE=0.04

# ============================================================
# E*TRADE API CREDENTIALS
# ============================================================
# Get these from E*TRADE Developer Portal: https://developer.etrade.com
#
ETRADE_CONSUMER_KEY=put_key_here
ETRADE_CONSUMER_SECRET=put_secret_here
#
# Optional: Account ID (auto-detected if omitted)
ETRADE_ACCOUNT_ID=put_acct_number_here

# Use sandbox for testing (set to true for sandbox keys)
ETRADE_SANDBOX=false

# Optional: Disable auto-sync on startup (default: true)
# ETRADE_AUTO_SYNC=true
